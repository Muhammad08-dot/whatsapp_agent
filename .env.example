# ==============================
# WhatsApp Agent Platform + Gemini
# ==============================
# Rename this file to .env and insert your real tokens.
# NEVER commit .env to version control!

# WhatsApp Agent API Token
# (Found in WhatsApp mobile app: Settings > Agents > Chat info > API key)
WHATSAPP_API_TOKEN=your_whatsapp_agent_token_here

# Google Gemini API Keys (comma-separated, supports 1 to 20 keys with automatic rotation)
# (Generated from: https://aistudio.google.com/apikey)
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7

# Agent Settings (Optional)
AGENT_NAME=Sufi_vela
GEMINI_MODEL=gemini-3.5-flash
LOG_LEVEL=INFO
